# Trix API Configuration
# Copy this file to .env and fill in your values

# Required: Your Trix API key
TRIX_API_KEY=your_api_key_here

# Optional: API base URL (defaults to https://api.trixdb.com)
# TRIX_BASE_URL=https://api.trixdb.com

# Optional: Default space ID for multi-tenant examples
# TRIX_SPACE_ID=your_space_id

# Optional: Webhook endpoint for webhook examples
# WEBHOOK_ENDPOINT=https://your-webhook-endpoint.com/webhook

